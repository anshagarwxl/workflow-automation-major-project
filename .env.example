# Copy to .env and change the secrets. .env is git-ignored and must never be committed.

# --- Application database (PostgreSQL)
DB_NAME=eventreg
DB_USERNAME=eventreg
DB_PASSWORD=change-me-db-password

# --- Email connector (SMTP). Defaults point at the bundled Mailpit test inbox.
# For a real mail server: SMTP_HOST=smtp.example.com, SMTP_PORT=587, SMTP_CRYPTO=TLS
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=eventreg
SMTP_PASSWORD=change-me-smtp-password
SMTP_CRYPTO=NONE
SMTP_FROM=noreply@campus.example.edu

# --- REST connector target (Student Records service). Default: the simulated SIS inside the backend.
STUDENT_RECORDS_URL=http://backend:8081

# --- Workflow timers: DEMO (minutes, for live demos) or STANDARD (24 h reminder, 72 h escalation)
SLA_PRESET=DEMO
SEED_DEMO_DATA=true

# --- Image versions
CAMUNDA_VERSION=8.8.33
CONNECTORS_VERSION=8.8.15
ELASTIC_VERSION=8.17.10
MAILPIT_VERSION=v1.21.8
