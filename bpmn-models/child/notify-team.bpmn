<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_NotifyTeam" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:error id="Error_NotificationFailed" name="Notification failed" errorCode="NOTIFICATION_FAILED" />
  <bpmn:process id="notify-team" name="Notify Team Members" isExecutable="true">
    <bpmn:documentation>Reusable child process (called through call activities). Input: notification {template: TEAM_APPROVED|TEAM_REJECTED|REGISTRATION_INVALID, registrationId, eventName, teamName, teamCode, source, remarks, recipients[{regNo, name, email}]}. Output: notificationStatus (DELIVERED|FAILED), deliveries.</bpmn:documentation>
    <bpmn:extensionElements><zeebe:versionTag value="2.0.0" /></bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_NotificationRequested" name="Notification requested"><bpmn:outgoing>Flow_Requested</bpmn:outgoing></bpmn:startEvent>
    <bpmn:scriptTask id="Task_ComposeMessage" name="Compose message"><bpmn:extensionElements><zeebe:script expression='={subject: if notification.template = "TEAM_APPROVED" then "Approved: team " + notification.teamName + " is registered for " + notification.eventName else if notification.template = "TEAM_REJECTED" then "Not approved: team " + notification.teamName + " (" + notification.eventName + ")" else "Registration for " + notification.eventName + " could not be accepted", html: if notification.template = "TEAM_APPROVED" then "&lt;p&gt;Your team &lt;b&gt;" + notification.teamName + "&lt;/b&gt; has been approved and is now registered for &lt;b&gt;" + notification.eventName + "&lt;/b&gt;.&lt;/p&gt;&lt;p&gt;Team code: &lt;b&gt;" + get or else(notification.teamCode, "-") + "&lt;/b&gt;&lt;/p&gt;" + (if notification.remarks != null and notification.remarks != "" then "&lt;p&gt;Remarks from the reviewer: " + notification.remarks + "&lt;/p&gt;" else "") else if notification.template = "TEAM_REJECTED" then "&lt;p&gt;Your team &lt;b&gt;" + notification.teamName + "&lt;/b&gt; was not approved for &lt;b&gt;" + notification.eventName + "&lt;/b&gt;.&lt;/p&gt;&lt;p&gt;Remarks: " + get or else(notification.remarks, "-") + "&lt;/p&gt;" + (if notification.source = "RANDOM" then "&lt;p&gt;You are back in the unallocated pool and will be placed in a new team in the next allocation round.&lt;/p&gt;" else "&lt;p&gt;Please fix the issues above and submit a new registration.&lt;/p&gt;") else "&lt;p&gt;Your registration for &lt;b&gt;" + notification.eventName + "&lt;/b&gt; could not be accepted.&lt;/p&gt;&lt;p&gt;Reason: " + get or else(notification.remarks, "-") + "&lt;/p&gt;&lt;p&gt;Please correct the details and register again.&lt;/p&gt;"}' resultVariable="message" /></bpmn:extensionElements><bpmn:incoming>Flow_Requested</bpmn:incoming><bpmn:outgoing>Flow_Composed</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="Task_EmailEachMember" name="Email each team member" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="3" /><zeebe:ioMapping><zeebe:input source="simple" target="authentication.type" /><zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" /><zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" /><zeebe:input source="smtp" target="protocol" /><zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" /><zeebe:input source="{{secrets.SMTP_PORT}}" target="data.smtpConfig.smtpPort" /><zeebe:input source="{{secrets.SMTP_CRYPTO}}" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="{{secrets.SMTP_FROM}}" target="data.smtpAction.from" /><zeebe:input source="=recipient.email" target="data.smtpAction.to" /><zeebe:input source="=message.subject" target="data.smtpAction.subject" /><zeebe:input source="HTML" target="data.smtpAction.contentType" /><zeebe:input source="=&quot;&lt;p&gt;Dear &quot; + recipient.name + &quot;,&lt;/p&gt;&quot; + message.html + &quot;&lt;p style='color:#555'&gt;Reference: &quot; + notification.registrationId + &quot;&lt;/p&gt;&lt;p style='color:#555'&gt;Regards,&lt;br/&gt;Event Registration Office&lt;/p&gt;&quot;" target="data.smtpAction.htmlBody" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="3" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" /><zeebe:header key="errorExpression" value='=if error != null then bpmnError("NOTIFICATION_FAILED", "Email delivery failed", {deliveryError: get or else(error.message, "unknown SMTP error")}) else null' /><zeebe:header key="retryBackoff" value="PT10S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_Composed</bpmn:incoming><bpmn:outgoing>Flow_AllSent</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=notification.recipients" inputElement="recipient" outputCollection="deliveries" outputElement='={regNo: recipient.regNo, email: recipient.email, status: "SENT"}' /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics></bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_NotificationFailed" name="Delivery failed" attachedToRef="Task_EmailEachMember"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=deliveryError" target="deliveryError" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:outgoing>Flow_DeliveryFailed</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_NotificationFailed" /></bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_LogDelivered" name="Log delivered notification"><bpmn:extensionElements><zeebe:taskDefinition type="record-notification" retries="3" /><zeebe:taskHeaders><zeebe:header key="outcome" value="DELIVERED" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_AllSent</bpmn:incoming><bpmn:outgoing>Flow_DeliveredLogged</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_TeamNotified" name="Team notified"><bpmn:incoming>Flow_DeliveredLogged</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_LogFailed" name="Log failed notification"><bpmn:extensionElements><zeebe:taskDefinition type="record-notification" retries="3" /><zeebe:taskHeaders><zeebe:header key="outcome" value="FAILED" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_DeliveryFailed</bpmn:incoming><bpmn:outgoing>Flow_FailedLogged</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_NotificationFailed" name="Failure logged"><bpmn:incoming>Flow_FailedLogged</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Requested" sourceRef="StartEvent_NotificationRequested" targetRef="Task_ComposeMessage" />
    <bpmn:sequenceFlow id="Flow_Composed" sourceRef="Task_ComposeMessage" targetRef="Task_EmailEachMember" />
    <bpmn:sequenceFlow id="Flow_AllSent" sourceRef="Task_EmailEachMember" targetRef="Task_LogDelivered" />
    <bpmn:sequenceFlow id="Flow_DeliveredLogged" sourceRef="Task_LogDelivered" targetRef="EndEvent_TeamNotified" />
    <bpmn:sequenceFlow id="Flow_DeliveryFailed" sourceRef="Boundary_NotificationFailed" targetRef="Task_LogFailed" />
    <bpmn:sequenceFlow id="Flow_FailedLogged" sourceRef="Task_LogFailed" targetRef="EndEvent_NotificationFailed" />
    <bpmn:textAnnotation id="TextAnnotation_Sequential"><bpmn:text>Sequential multi-instance: one email per member, sent one after another to respect SMTP rate limits</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Sequential" sourceRef="Task_EmailEachMember" targetRef="TextAnnotation_Sequential"></bpmn:association>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="notify-team">
      <bpmndi:BPMNShape id="StartEvent_NotificationRequested_di" bpmnElement="StartEvent_NotificationRequested"><dc:Bounds x="232" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="215" y="220" width="70" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ComposeMessage_di" bpmnElement="Task_ComposeMessage"><dc:Bounds x="310" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EmailEachMember_di" bpmnElement="Task_EmailEachMember"><dc:Bounds x="470" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_NotificationFailed_di" bpmnElement="Boundary_NotificationFailed"><dc:Bounds x="557" y="222" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="593" y="270" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogDelivered_di" bpmnElement="Task_LogDelivered"><dc:Bounds x="630" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_TeamNotified_di" bpmnElement="EndEvent_TeamNotified"><dc:Bounds x="812" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="797" y="220" width="66" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogFailed_di" bpmnElement="Task_LogFailed"><dc:Bounds x="630" y="290" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_NotificationFailed_di" bpmnElement="EndEvent_NotificationFailed"><dc:Bounds x="812" y="312" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="794" y="350" width="72" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_Sequential_di" bpmnElement="TextAnnotation_Sequential"><dc:Bounds x="470" y="70" width="260" height="55" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_Sequential_di" bpmnElement="Association_Sequential"><di:waypoint x="530" y="160" /><di:waypoint x="530" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Requested_di" bpmnElement="Flow_Requested"><di:waypoint x="268" y="200" /><di:waypoint x="310" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Composed_di" bpmnElement="Flow_Composed"><di:waypoint x="430" y="200" /><di:waypoint x="470" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AllSent_di" bpmnElement="Flow_AllSent"><di:waypoint x="590" y="200" /><di:waypoint x="630" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DeliveredLogged_di" bpmnElement="Flow_DeliveredLogged"><di:waypoint x="750" y="200" /><di:waypoint x="812" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DeliveryFailed_di" bpmnElement="Flow_DeliveryFailed"><di:waypoint x="575" y="258" /><di:waypoint x="575" y="330" /><di:waypoint x="630" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FailedLogged_di" bpmnElement="Flow_FailedLogged"><di:waypoint x="750" y="330" /><di:waypoint x="812" y="330" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
