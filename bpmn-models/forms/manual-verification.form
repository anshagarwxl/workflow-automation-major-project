{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.40.0"
  },
  "schemaVersion": 16,
  "id": "manual-verification",
  "type": "default",
  "components": [
    {
      "type": "text",
      "id": "Field_heading",
      "text": "## Manual verification\nThe Student Records service did not verify this registration within {{sla.verificationTimeout}}. Check each member against the official records."
    },
    {
      "type": "text",
      "id": "Field_teamSummary",
      "text": "**Event:** {{registration.eventName}}\n\n**Team name:** {{registration.teamName}}\n\n**Team type:** {{if registration.source = \"RANDOM\" then \"Randomly allocated team\" else \"Self-formed team\"}}"
    },
    {
      "type": "table",
      "id": "Field_members",
      "label": "Team members",
      "dataSource": "=registration.members",
      "rowCount": 10,
      "columns": [
        {
          "label": "Reg. no.",
          "key": "regNo"
        },
        {
          "label": "Name",
          "key": "name"
        },
        {
          "label": "Email",
          "key": "email"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "Field_manuallyVerified",
      "label": "All members are enrolled and eligible for this event",
      "key": "manuallyVerified"
    },
    {
      "type": "textarea",
      "id": "Field_invalidReason",
      "label": "Reason (if not verified)",
      "key": "invalidReason",
      "conditional": {
        "hide": "=manuallyVerified = true"
      }
    }
  ]
}
