<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_EventTeamRegistration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_EventTeamRegistration"><bpmn:participant id="Participant_Registration" name="Event Team Registration" processRef="event-team-registration" /></bpmn:collaboration>
  <bpmn:error id="Error_RegistrationInvalid" name="Registration invalid" errorCode="REGISTRATION_INVALID" />
  <bpmn:error id="Error_MemberConflict" name="Member already approved" errorCode="MEMBER_CONFLICT" />
  <bpmn:process id="event-team-registration" name="Event Team Registration" isExecutable="true">
    <bpmn:documentation>Main process, one instance per registration request: a self-formed team, an individual student, or a random team generated by Random Team Allocation. Start variables: registration {registrationId, eventId, eventName, mode: TEAM|INDIVIDUAL, source: SELF_FORMED|RANDOM, teamName, members[{regNo, name, email}], faId, faName, faEmail}, sla {verificationTimeout, faReminderAfter, faEscalationAfter} (ISO-8601 durations), coordinatorEmail.</bpmn:documentation>
    <bpmn:extensionElements><zeebe:versionTag value="2.0.0" /></bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Registration">
      <bpmn:lane id="Lane_Student" name="Student"><bpmn:flowNodeRef>StartEvent_RegistrationSubmitted</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_System" name="System (job workers and connectors)"><bpmn:flowNodeRef>SubProcess_VerifyRegistration</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_VerificationTimeout</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_RegistrationInvalid</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_InvalidMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RecordInvalid</bpmn:flowNodeRef><bpmn:flowNodeRef>CallActivity_NotifyInvalid</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_RegistrationInvalid</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_VerifiedMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_HasTeam</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AddToPool</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_WaitingForAllocation</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_FADecision</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SaveApprovedTeam</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_MemberConflict</bpmn:flowNodeRef><bpmn:flowNodeRef>CallActivity_NotifyApproved</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_TeamRegistered</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_RejectMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RecordRejection</bpmn:flowNodeRef><bpmn:flowNodeRef>CallActivity_NotifyRejected</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_TeamRejected</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_FA" name="Faculty Advisor"><bpmn:flowNodeRef>SubProcess_FAReview</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_FAEscalation</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_DecisionMerge</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Coordinator" name="Event Coordinator"><bpmn:flowNodeRef>Task_ManualVerification</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ManualVerdict</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotifyCoordinatorEscalation</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CoordinatorReview</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_RegistrationSubmitted" name="Registration submitted"><bpmn:outgoing>Flow_Submitted</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_VerifyRegistration" name="Verify registration"><bpmn:incoming>Flow_Submitted</bpmn:incoming><bpmn:outgoing>Flow_Verified</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_VerifyStarted" name="Verification started"><bpmn:outgoing>Flow_VerifyStarted</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="Task_ValidateRegistration" name="Validate registration rules"><bpmn:extensionElements><zeebe:taskDefinition type="validate-registration" retries="3" /><zeebe:ioMapping><zeebe:output source="=valid" target="valid" /><zeebe:output source="=memberCount" target="memberCount" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_VerifyStarted</bpmn:incoming><bpmn:outgoing>Flow_RulesPassed</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="Task_VerifyMember" name="Verify each member with Student Records" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="11"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source='="{{secrets.STUDENT_RECORDS_URL}}/api/sis/students/" + member.regNo' target="url" /><zeebe:input source="={eventId: registration.eventId}" target="queryParameters" /><zeebe:input source='={"Accept": "application/json"}' target="headers" /><zeebe:input source="10" target="connectionTimeoutInSeconds" /><zeebe:input source="10" target="readTimeoutInSeconds" /><zeebe:input source="=null" target="memberCheck" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="11" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" /><zeebe:header key="resultExpression" value="={memberCheck: {regNo: response.body.regNo, name: response.body.name, department: response.body.department, enrollmentStatus: response.body.enrollmentStatus, eligible: response.body.eligible, reason: response.body.reason}}" /><zeebe:header key="errorExpression" value='=if error.code = "404" then bpmnError("REGISTRATION_INVALID", "A team member is not in Student Records", {invalidReason: "A team member is not registered in Student Records: " + get or else(error.message, "not found")}) else null' /><zeebe:header key="retryBackoff" value="PT10S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_RulesPassed</bpmn:incoming><bpmn:outgoing>Flow_MembersChecked</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=registration.members" inputElement="member" outputCollection="memberChecks" outputElement="=memberCheck" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_AllEligible" name="All members eligible?" default="Flow_SomeIneligible"><bpmn:incoming>Flow_MembersChecked</bpmn:incoming><bpmn:outgoing>Flow_AllEligible</bpmn:outgoing><bpmn:outgoing>Flow_SomeIneligible</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent_Verified" name="Registration verified"><bpmn:incoming>Flow_AllEligible</bpmn:incoming></bpmn:endEvent>
      <bpmn:scriptTask id="Task_SummariseIneligible" name="Summarise ineligible members"><bpmn:extensionElements><zeebe:script expression='="Not eligible for this event: " + string join(for c in memberChecks[eligible != true] return c.regNo + " (" + get or else(c.reason, "not eligible") + ")", ", ")' resultVariable="invalidReason" /></bpmn:extensionElements><bpmn:incoming>Flow_SomeIneligible</bpmn:incoming><bpmn:outgoing>Flow_IneligibleSummarised</bpmn:outgoing></bpmn:scriptTask>
      <bpmn:endEvent id="EndEvent_IneligibleMember" name="Ineligible member found"><bpmn:incoming>Flow_IneligibleSummarised</bpmn:incoming><bpmn:errorEventDefinition errorRef="Error_RegistrationInvalid" /></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_VerifyStarted" sourceRef="StartEvent_VerifyStarted" targetRef="Task_ValidateRegistration" />
      <bpmn:sequenceFlow id="Flow_RulesPassed" sourceRef="Task_ValidateRegistration" targetRef="Task_VerifyMember" />
      <bpmn:sequenceFlow id="Flow_MembersChecked" sourceRef="Task_VerifyMember" targetRef="Gateway_AllEligible" />
      <bpmn:sequenceFlow id="Flow_AllEligible" name="yes" sourceRef="Gateway_AllEligible" targetRef="EndEvent_Verified"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=all(memberChecks.eligible)</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_SomeIneligible" name="no" sourceRef="Gateway_AllEligible" targetRef="Task_SummariseIneligible" />
      <bpmn:sequenceFlow id="Flow_IneligibleSummarised" sourceRef="Task_SummariseIneligible" targetRef="EndEvent_IneligibleMember" /></bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_VerificationTimeout" name="Verification not finished in time" attachedToRef="SubProcess_VerifyRegistration"><bpmn:outgoing>Flow_VerificationTimedOut</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=sla.verificationTimeout</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_RegistrationInvalid" name="Registration invalid" attachedToRef="SubProcess_VerifyRegistration"><bpmn:outgoing>Flow_InvalidCaught</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_RegistrationInvalid" /></bpmn:boundaryEvent>
    <bpmn:userTask id="Task_ManualVerification" name="Verify registration manually"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="manual-verification" /><zeebe:assignmentDefinition candidateGroups="event-coordinators" /></bpmn:extensionElements><bpmn:incoming>Flow_VerificationTimedOut</bpmn:incoming><bpmn:outgoing>Flow_ManuallyChecked</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ManualVerdict" name="Manually verified?" default="Flow_ManualRejected"><bpmn:incoming>Flow_ManuallyChecked</bpmn:incoming><bpmn:outgoing>Flow_ManualRejected</bpmn:outgoing><bpmn:outgoing>Flow_ManualVerified</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_InvalidMerge"><bpmn:incoming>Flow_InvalidCaught</bpmn:incoming><bpmn:incoming>Flow_ManualRejected</bpmn:incoming><bpmn:outgoing>Flow_ToRecordInvalid</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RecordInvalid" name="Record invalid registration"><bpmn:extensionElements><zeebe:taskDefinition type="record-invalid-registration" retries="3" /><zeebe:ioMapping><zeebe:input source='=get or else(invalidReason, "The registration failed verification")' target="invalidReason" /><zeebe:output source="=invalidReason" target="invalidReason" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_ToRecordInvalid</bpmn:incoming><bpmn:outgoing>Flow_InvalidRecorded</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:callActivity id="CallActivity_NotifyInvalid" name="Notify student: registration invalid"><bpmn:extensionElements><zeebe:calledElement processId="notify-team" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source='={template: "REGISTRATION_INVALID", registrationId: registration.registrationId, eventName: registration.eventName, teamName: get or else(registration.teamName, "Individual registration"), source: registration.source, remarks: invalidReason, recipients: registration.members}' target="notification" /><zeebe:output source="=notificationStatus" target="lastNotificationStatus" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_InvalidRecorded</bpmn:incoming><bpmn:outgoing>Flow_InvalidNotified</bpmn:outgoing></bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_RegistrationInvalid" name="Registration invalid"><bpmn:incoming>Flow_InvalidNotified</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_VerifiedMerge"><bpmn:incoming>Flow_Verified</bpmn:incoming><bpmn:incoming>Flow_ManualVerified</bpmn:incoming><bpmn:outgoing>Flow_ToHasTeam</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_HasTeam" name="Has a team?" default="Flow_NoTeam"><bpmn:incoming>Flow_ToHasTeam</bpmn:incoming><bpmn:outgoing>Flow_NoTeam</bpmn:outgoing><bpmn:outgoing>Flow_HasTeam</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AddToPool" name="Add student to unallocated pool"><bpmn:extensionElements><zeebe:taskDefinition type="add-to-unallocated-pool" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_NoTeam</bpmn:incoming><bpmn:outgoing>Flow_Pooled</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOutputAssociation_AddToPool"><bpmn:targetRef>DataStore_RegistrationDB</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_WaitingForAllocation" name="Waiting for random allocation"><bpmn:incoming>Flow_Pooled</bpmn:incoming></bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_FAReview" name="Faculty Advisor review"><bpmn:incoming>Flow_HasTeam</bpmn:incoming><bpmn:outgoing>Flow_FAReviewDone</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_FAReviewStarted" name="Review requested"><bpmn:outgoing>Flow_FAReviewStarted</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="Task_FAReview" name="Review team details"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="fa-team-review" /><zeebe:assignmentDefinition assignee="=registration.faId" candidateGroups="faculty-advisors" /><zeebe:taskSchedule dueDate="=now() + duration(sla.faEscalationAfter)" /></bpmn:extensionElements><bpmn:incoming>Flow_FAReviewStarted</bpmn:incoming><bpmn:outgoing>Flow_FADecided</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="Task_RemindFA" name="Send reminder to FA" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="3" /><zeebe:ioMapping><zeebe:input source="simple" target="authentication.type" /><zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" /><zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" /><zeebe:input source="smtp" target="protocol" /><zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" /><zeebe:input source="{{secrets.SMTP_PORT}}" target="data.smtpConfig.smtpPort" /><zeebe:input source="{{secrets.SMTP_CRYPTO}}" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="{{secrets.SMTP_FROM}}" target="data.smtpAction.from" /><zeebe:input source="=registration.faEmail" target="data.smtpAction.to" /><zeebe:input source='="Reminder: team " + registration.teamName + " is waiting for your review"' target="data.smtpAction.subject" /><zeebe:input source="HTML" target="data.smtpAction.contentType" /><zeebe:input source="=&quot;&lt;p&gt;Dear &quot; + registration.faName + &quot;,&lt;/p&gt;&lt;p&gt;The team &lt;b&gt;&quot; + registration.teamName + &quot;&lt;/b&gt; registered for &lt;b&gt;&quot; + registration.eventName + &quot;&lt;/b&gt; is still waiting for your decision.&lt;/p&gt;&lt;p&gt;Please open your Tasklist inbox and approve or reject the team. If no decision is recorded, the review is escalated to the Event Coordinator.&lt;/p&gt;&lt;p style='color:#555'&gt;Regards,&lt;br/&gt;Event Registration Office&lt;/p&gt;&quot;" target="data.smtpAction.htmlBody" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="3" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" /><zeebe:header key="retryBackoff" value="PT10S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_ReminderDue</bpmn:incoming><bpmn:outgoing>Flow_ReminderSent</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_ReminderSent" name="Reminder sent"><bpmn:incoming>Flow_ReminderSent</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="EndEvent_FAReviewed" name="Decision recorded"><bpmn:incoming>Flow_FADecided</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_FAReviewStarted" sourceRef="StartEvent_FAReviewStarted" targetRef="Task_FAReview" />
      <bpmn:sequenceFlow id="Flow_FADecided" sourceRef="Task_FAReview" targetRef="EndEvent_FAReviewed" />
      <bpmn:sequenceFlow id="Flow_ReminderDue" sourceRef="Boundary_FAReminder" targetRef="Task_RemindFA" />
      <bpmn:sequenceFlow id="Flow_ReminderSent" sourceRef="Task_RemindFA" targetRef="EndEvent_ReminderSent" /></bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_FAReminder" name="Reminder interval elapsed" cancelActivity="false" attachedToRef="Task_FAReview"><bpmn:outgoing>Flow_ReminderDue</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">=cycle(duration(sla.faReminderAfter))</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_FAEscalation" name="No decision within SLA" attachedToRef="SubProcess_FAReview"><bpmn:outgoing>Flow_Escalated</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=sla.faEscalationAfter</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_NotifyCoordinatorEscalation" name="Notify coordinator: review escalated" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="3" /><zeebe:ioMapping><zeebe:input source="simple" target="authentication.type" /><zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" /><zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" /><zeebe:input source="smtp" target="protocol" /><zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" /><zeebe:input source="{{secrets.SMTP_PORT}}" target="data.smtpConfig.smtpPort" /><zeebe:input source="{{secrets.SMTP_CRYPTO}}" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="{{secrets.SMTP_FROM}}" target="data.smtpAction.from" /><zeebe:input source="=coordinatorEmail" target="data.smtpAction.to" /><zeebe:input source='="Escalated: FA review overdue for team " + registration.teamName' target="data.smtpAction.subject" /><zeebe:input source="HTML" target="data.smtpAction.contentType" /><zeebe:input source="=&quot;&lt;p&gt;The Faculty Advisor review for team &lt;b&gt;&quot; + registration.teamName + &quot;&lt;/b&gt; (&quot; + registration.eventName + &quot;) was not completed within &quot; + sla.faEscalationAfter + &quot;.&lt;/p&gt;&lt;p&gt;The review has been moved to your Tasklist inbox. Please approve or reject the team.&lt;/p&gt;&lt;p style='color:#555'&gt;Regards,&lt;br/&gt;Event Registration Office&lt;/p&gt;&quot;" target="data.smtpAction.htmlBody" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="3" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" /><zeebe:header key="retryBackoff" value="PT10S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_Escalated</bpmn:incoming><bpmn:outgoing>Flow_EscalationNotified</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_CoordinatorReview" name="Review escalated team"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="coordinator-escalated-review" /><zeebe:assignmentDefinition candidateGroups="event-coordinators" /></bpmn:extensionElements><bpmn:incoming>Flow_EscalationNotified</bpmn:incoming><bpmn:outgoing>Flow_CoordinatorDecided</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DecisionMerge"><bpmn:incoming>Flow_FAReviewDone</bpmn:incoming><bpmn:incoming>Flow_CoordinatorDecided</bpmn:incoming><bpmn:outgoing>Flow_ToDecision</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_FADecision" name="FA decision?" default="Flow_Rejected"><bpmn:incoming>Flow_ToDecision</bpmn:incoming><bpmn:outgoing>Flow_Approved</bpmn:outgoing><bpmn:outgoing>Flow_Rejected</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SaveApprovedTeam" name="Save team to Approved Teams DB"><bpmn:extensionElements><zeebe:taskDefinition type="save-approved-team" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_Approved</bpmn:incoming><bpmn:outgoing>Flow_Saved</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOutputAssociation_SaveApproved"><bpmn:targetRef>DataStore_ApprovedTeamsDB</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_MemberConflict" name="Member already in an approved team" attachedToRef="Task_SaveApprovedTeam"><bpmn:outgoing>Flow_MemberConflict</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_MemberConflict" /></bpmn:boundaryEvent>
    <bpmn:callActivity id="CallActivity_NotifyApproved" name="Notify team: approved"><bpmn:extensionElements><zeebe:calledElement processId="notify-team" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source='={template: "TEAM_APPROVED", registrationId: registration.registrationId, eventName: registration.eventName, teamName: get or else(registration.teamName, "Individual registration"), source: registration.source, remarks: get or else(faRemarks, ""), teamCode: approvedTeam.teamCode, recipients: registration.members}' target="notification" /><zeebe:output source="=notificationStatus" target="lastNotificationStatus" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Saved</bpmn:incoming><bpmn:outgoing>Flow_ApprovedNotified</bpmn:outgoing></bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_TeamRegistered" name="Team registered"><bpmn:incoming>Flow_ApprovedNotified</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_RejectMerge"><bpmn:incoming>Flow_Rejected</bpmn:incoming><bpmn:incoming>Flow_MemberConflict</bpmn:incoming><bpmn:outgoing>Flow_ToRecordRejection</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RecordRejection" name="Record rejection"><bpmn:extensionElements><zeebe:taskDefinition type="record-rejection" retries="3" /><zeebe:ioMapping><zeebe:input source='=if conflictMessage != null then "Automatically rejected: " + conflictMessage else get or else(faRemarks, "No remarks provided")' target="rejectionRemarks" /><zeebe:output source="=rejectionRemarks" target="rejectionRemarks" /><zeebe:output source="=returnedToPool" target="returnedToPool" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_ToRecordRejection</bpmn:incoming><bpmn:outgoing>Flow_RejectionRecorded</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:callActivity id="CallActivity_NotifyRejected" name="Notify team: rejected with remarks"><bpmn:extensionElements><zeebe:calledElement processId="notify-team" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source='={template: "TEAM_REJECTED", registrationId: registration.registrationId, eventName: registration.eventName, teamName: get or else(registration.teamName, "Individual registration"), source: registration.source, remarks: rejectionRemarks, recipients: registration.members}' target="notification" /><zeebe:output source="=notificationStatus" target="lastNotificationStatus" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_RejectionRecorded</bpmn:incoming><bpmn:outgoing>Flow_RejectedNotified</bpmn:outgoing></bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_TeamRejected" name="Team rejected"><bpmn:incoming>Flow_RejectedNotified</bpmn:incoming></bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStore_RegistrationDB" name="Registration DB"></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DataStore_ApprovedTeamsDB" name="Approved Teams DB"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="Flow_VerificationTimedOut" sourceRef="Boundary_VerificationTimeout" targetRef="Task_ManualVerification" />
    <bpmn:sequenceFlow id="Flow_ManuallyChecked" sourceRef="Task_ManualVerification" targetRef="Gateway_ManualVerdict" />
