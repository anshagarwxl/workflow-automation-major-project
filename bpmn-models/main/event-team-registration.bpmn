    <bpmn:sequenceFlow id="Flow_ToDecision" sourceRef="Gateway_DecisionMerge" targetRef="Gateway_FADecision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="approved" sourceRef="Gateway_FADecision" targetRef="Task_SaveApprovedTeam"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "APPROVED"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Saved" sourceRef="Task_SaveApprovedTeam" targetRef="CallActivity_NotifyApproved" />
    <bpmn:sequenceFlow id="Flow_ApprovedNotified" sourceRef="CallActivity_NotifyApproved" targetRef="EndEvent_TeamRegistered" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="rejected" sourceRef="Gateway_FADecision" targetRef="Gateway_RejectMerge" />
    <bpmn:sequenceFlow id="Flow_MemberConflict" sourceRef="Boundary_MemberConflict" targetRef="Gateway_RejectMerge" />
    <bpmn:sequenceFlow id="Flow_ToRecordRejection" sourceRef="Gateway_RejectMerge" targetRef="Task_RecordRejection" />
    <bpmn:sequenceFlow id="Flow_RejectionRecorded" sourceRef="Task_RecordRejection" targetRef="CallActivity_NotifyRejected" />
    <bpmn:sequenceFlow id="Flow_RejectedNotified" sourceRef="CallActivity_NotifyRejected" targetRef="EndEvent_TeamRejected" />
    <bpmn:sequenceFlow id="Flow_Submitted" sourceRef="StartEvent_RegistrationSubmitted" targetRef="SubProcess_VerifyRegistration" />
    <bpmn:textAnnotation id="TextAnnotation_StartedBy"><bpmn:text>Started by the web portal (self-formed team or individual student) or by Random Team Allocation (random team)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_SLA"><bpmn:text>Timer durations come from the 'sla' variable (FEEL), e.g. reminder every PT24H, escalation after PT72H, verification timeout PT10M</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_RandomRejected"><bpmn:text>Rejected random team: its members go back to the unallocated pool and are regrouped in the next allocation round</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_StartedBy" sourceRef="StartEvent_RegistrationSubmitted" targetRef="TextAnnotation_StartedBy"></bpmn:association>
    <bpmn:association id="Association_SLA" sourceRef="Boundary_FAEscalation" targetRef="TextAnnotation_SLA"></bpmn:association>
    <bpmn:association id="Association_RandomRejected" sourceRef="Task_RecordRejection" targetRef="TextAnnotation_RandomRejected"></bpmn:association>
  </bpmn:process>
