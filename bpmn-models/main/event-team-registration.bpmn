    <bpmn:sequenceFlow id="Flow_Verified" sourceRef="SubProcess_VerifyRegistration" targetRef="Gateway_VerifiedMerge" />
    <bpmn:sequenceFlow id="Flow_ManualVerified" name="yes" sourceRef="Gateway_ManualVerdict" targetRef="Gateway_VerifiedMerge"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=manuallyVerified = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToHasTeam" sourceRef="Gateway_VerifiedMerge" targetRef="Gateway_HasTeam" />
    <bpmn:sequenceFlow id="Flow_NoTeam" name="no" sourceRef="Gateway_HasTeam" targetRef="Task_AddToPool" />
    <bpmn:sequenceFlow id="Flow_Pooled" sourceRef="Task_AddToPool" targetRef="EndEvent_WaitingForAllocation" />
    <bpmn:sequenceFlow id="Flow_HasTeam" name="yes" sourceRef="Gateway_HasTeam" targetRef="SubProcess_FAReview"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=registration.mode = "TEAM"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Escalated" sourceRef="Boundary_FAEscalation" targetRef="Task_NotifyCoordinatorEscalation" />
    <bpmn:sequenceFlow id="Flow_EscalationNotified" sourceRef="Task_NotifyCoordinatorEscalation" targetRef="Task_CoordinatorReview" />
    <bpmn:sequenceFlow id="Flow_FAReviewDone" sourceRef="SubProcess_FAReview" targetRef="Gateway_DecisionMerge" />
