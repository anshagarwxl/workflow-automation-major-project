<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_RandomTeamAllocation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_RandomTeamAllocation"><bpmn:participant id="Participant_Allocation" name="Random Team Allocation" processRef="random-team-allocation" /></bpmn:collaboration>
  <bpmn:message id="Message_RegistrationClosed" name="registration-closed" />
  <bpmn:error id="Error_InsufficientStudents" name="Insufficient students" errorCode="INSUFFICIENT_STUDENTS" />
  <bpmn:process id="random-team-allocation" name="Random Team Allocation" isExecutable="true">
    <bpmn:documentation>Event-level process, one instance per event, started by the message 'registration-closed' (variables: eventId, eventName, minTeamSize, maxTeamSize, maxAllocationRounds, allocationRound = 0, sla, coordinatorEmail). Groups unallocated students into random teams and sends each team through Event Team Registration for FA confirmation.</bpmn:documentation>
    <bpmn:extensionElements><zeebe:versionTag value="2.0.0" /></bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_RegistrationClosed" name="Registration closed"><bpmn:outgoing>Flow_Closed</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_RegistrationClosed" /></bpmn:startEvent>
    <bpmn:serviceTask id="Task_FetchUnallocated" name="Fetch unallocated students"><bpmn:extensionElements><zeebe:taskDefinition type="fetch-unallocated-students" retries="3" /><zeebe:ioMapping><zeebe:output source="=unallocatedCount" target="unallocatedCount" /><zeebe:output source="=unallocatedStudents" target="unallocatedStudents" /><zeebe:output source="=get or else(allocationRound, 0) + 1" target="allocationRound" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Closed</bpmn:incoming><bpmn:incoming>Flow_RecheckPool</bpmn:incoming><bpmn:outgoing>Flow_Fetched</bpmn:outgoing><bpmn:property id="Property_FetchUnallocated" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DataInputAssociation_FetchUnallocated"><bpmn:sourceRef>DataStore_RegistrationDB</bpmn:sourceRef><bpmn:targetRef>Property_FetchUnallocated</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AnyStudentsLeft" name="Students without a team?" default="Flow_NoneLeft"><bpmn:incoming>Flow_Fetched</bpmn:incoming><bpmn:outgoing>Flow_StudentsLeft</bpmn:outgoing><bpmn:outgoing>Flow_NoneLeft</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_RoundsLeft" name="Allocation rounds left?" default="Flow_RoundsExhausted"><bpmn:incoming>Flow_StudentsLeft</bpmn:incoming><bpmn:outgoing>Flow_RoundsLeft</bpmn:outgoing><bpmn:outgoing>Flow_RoundsExhausted</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AllocateRandomTeams" name="Randomly allocate students into teams"><bpmn:extensionElements><zeebe:taskDefinition type="allocate-random-teams" retries="3" /><zeebe:ioMapping><zeebe:output source="=generatedTeams" target="generatedTeams" /><zeebe:output source="=count(generatedTeams)" target="teamsGenerated" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_RoundsLeft</bpmn:incoming><bpmn:outgoing>Flow_Allocated</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_InsufficientStudents" name="Too few students for a team" attachedToRef="Task_AllocateRandomTeams"><bpmn:outgoing>Flow_InsufficientStudents</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_InsufficientStudents" /></bpmn:boundaryEvent>
    <bpmn:callActivity id="CallActivity_RegisterRandomTeam" name="Register each random team (FA confirmation)"><bpmn:extensionElements><zeebe:calledElement processId="event-team-registration" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="=randomTeam" target="registration" /><zeebe:input source="=sla" target="sla" /><zeebe:input source="=coordinatorEmail" target="coordinatorEmail" /><zeebe:input source="=null" target="teamDecision" /><zeebe:output source='=get or else(decision, "NOT_DECIDED")' target="teamDecision" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Allocated</bpmn:incoming><bpmn:outgoing>Flow_RecheckPool</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=generatedTeams" inputElement="randomTeam" outputCollection="allocationResults" outputElement="={teamName: randomTeam.teamName, registrationId: randomTeam.registrationId, decision: teamDecision}" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics></bpmn:callActivity>
    <bpmn:serviceTask id="Task_SendAllocationSummary" name="Send allocation summary to coordinator" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="3" /><zeebe:ioMapping><zeebe:input source="simple" target="authentication.type" /><zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" /><zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" /><zeebe:input source="smtp" target="protocol" /><zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" /><zeebe:input source="{{secrets.SMTP_PORT}}" target="data.smtpConfig.smtpPort" /><zeebe:input source="{{secrets.SMTP_CRYPTO}}" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="{{secrets.SMTP_FROM}}" target="data.smtpAction.from" /><zeebe:input source="=coordinatorEmail" target="data.smtpAction.to" /><zeebe:input source='="Random allocation complete: " + eventName' target="data.smtpAction.subject" /><zeebe:input source="HTML" target="data.smtpAction.contentType" /><zeebe:input source="=&quot;&lt;p&gt;Every student registered for &lt;b&gt;&quot; + eventName + &quot;&lt;/b&gt; now has a team.&lt;/p&gt;&lt;p&gt;Allocation rounds run: &quot; + string(allocationRound - 1) + &quot;&lt;/p&gt;&lt;p&gt;Open the coordinator console to see the approved teams.&lt;/p&gt;&lt;p style='color:#555'&gt;Regards,&lt;br/&gt;Event Registration Office&lt;/p&gt;&quot;" target="data.smtpAction.htmlBody" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="3" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" /><zeebe:header key="retryBackoff" value="PT10S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_NoneLeft</bpmn:incoming><bpmn:outgoing>Flow_SummarySent</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_AllStudentsPlaced" name="All students placed"><bpmn:incoming>Flow_SummarySent</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_ManualMerge"><bpmn:incoming>Flow_RoundsExhausted</bpmn:incoming><bpmn:incoming>Flow_InsufficientStudents</bpmn:incoming><bpmn:outgoing>Flow_ToManualPlacement</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RequestManualPlacement" name="Ask coordinator to place remaining students" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="3" /><zeebe:ioMapping><zeebe:input source="simple" target="authentication.type" /><zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" /><zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" /><zeebe:input source="smtp" target="protocol" /><zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" /><zeebe:input source="{{secrets.SMTP_PORT}}" target="data.smtpConfig.smtpPort" /><zeebe:input source="{{secrets.SMTP_CRYPTO}}" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="{{secrets.SMTP_FROM}}" target="data.smtpAction.from" /><zeebe:input source="=coordinatorEmail" target="data.smtpAction.to" /><zeebe:input source='="Manual placement needed: " + eventName' target="data.smtpAction.subject" /><zeebe:input source="HTML" target="data.smtpAction.contentType" /><zeebe:input source="=&quot;&lt;p&gt;&quot; + string(unallocatedCount) + &quot; student(s) registered for &lt;b&gt;&quot; + eventName + &quot;&lt;/b&gt; could not be placed automatically.&lt;/p&gt;&lt;p&gt;Reason: &quot; + get or else(allocationError, &quot;the maximum number of allocation rounds (&quot; + string(maxAllocationRounds) + &quot;) was reached&quot;) + &quot;&lt;/p&gt;&lt;p&gt;Please place them manually from the coordinator console.&lt;/p&gt;&lt;p style='color:#555'&gt;Regards,&lt;br/&gt;Event Registration Office&lt;/p&gt;&quot;" target="data.smtpAction.htmlBody" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="3" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" /><zeebe:header key="retryBackoff" value="PT10S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_ToManualPlacement</bpmn:incoming><bpmn:outgoing>Flow_ManualPlacementRequested</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ManualPlacement" name="Manual placement required"><bpmn:incoming>Flow_ManualPlacementRequested</bpmn:incoming></bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStore_RegistrationDB" name="Registration DB"></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="Flow_Closed" sourceRef="StartEvent_RegistrationClosed" targetRef="Task_FetchUnallocated" />
    <bpmn:sequenceFlow id="Flow_Fetched" sourceRef="Task_FetchUnallocated" targetRef="Gateway_AnyStudentsLeft" />
    <bpmn:sequenceFlow id="Flow_StudentsLeft" name="yes" sourceRef="Gateway_AnyStudentsLeft" targetRef="Gateway_RoundsLeft"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=unallocatedCount &gt; 0</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoneLeft" name="no" sourceRef="Gateway_AnyStudentsLeft" targetRef="Task_SendAllocationSummary" />
    <bpmn:sequenceFlow id="Flow_RoundsLeft" name="yes" sourceRef="Gateway_RoundsLeft" targetRef="Task_AllocateRandomTeams"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=allocationRound &lt;= maxAllocationRounds</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RoundsExhausted" name="no" sourceRef="Gateway_RoundsLeft" targetRef="Gateway_ManualMerge" />
    <bpmn:sequenceFlow id="Flow_InsufficientStudents" sourceRef="Boundary_InsufficientStudents" targetRef="Gateway_ManualMerge" />
    <bpmn:sequenceFlow id="Flow_ToManualPlacement" sourceRef="Gateway_ManualMerge" targetRef="Task_RequestManualPlacement" />
    <bpmn:sequenceFlow id="Flow_ManualPlacementRequested" sourceRef="Task_RequestManualPlacement" targetRef="EndEvent_ManualPlacement" />
    <bpmn:sequenceFlow id="Flow_Allocated" sourceRef="Task_AllocateRandomTeams" targetRef="CallActivity_RegisterRandomTeam" />
    <bpmn:sequenceFlow id="Flow_RecheckPool" name="all FA decisions received: re-check the pool" sourceRef="CallActivity_RegisterRandomTeam" targetRef="Task_FetchUnallocated" />
    <bpmn:sequenceFlow id="Flow_SummarySent" sourceRef="Task_SendAllocationSummary" targetRef="EndEvent_AllStudentsPlaced" />
    <bpmn:textAnnotation id="TextAnnotation_CallActivity"><bpmn:text>Call activity, parallel multi-instance: starts 'Event Team Registration' once per generated team (mode = TEAM, source = RANDOM) and collects every FA decision in allocationResults</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_CallActivity" sourceRef="CallActivity_RegisterRandomTeam" targetRef="TextAnnotation_CallActivity"></bpmn:association>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_RandomTeamAllocation">
      <bpmndi:BPMNShape id="Participant_Allocation_di" bpmnElement="Participant_Allocation" isHorizontal="true"><dc:Bounds x="160" y="20" width="1260" height="490" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_RegistrationClosed_di" bpmnElement="StartEvent_RegistrationClosed"><dc:Bounds x="232" y="252" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="220" y="290" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FetchUnallocated_di" bpmnElement="Task_FetchUnallocated"><dc:Bounds x="310" y="230" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AnyStudentsLeft_di" bpmnElement="Gateway_AnyStudentsLeft" isMarkerVisible="true"><dc:Bounds x="475" y="245" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="436" y="302" width="130" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RoundsLeft_di" bpmnElement="Gateway_RoundsLeft" isMarkerVisible="true"><dc:Bounds x="585" y="245" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="548" y="205" width="124" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AllocateRandomTeams_di" bpmnElement="Task_AllocateRandomTeams"><dc:Bounds x="680" y="230" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_InsufficientStudents_di" bpmnElement="Boundary_InsufficientStudents"><dc:Bounds x="742" y="292" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="778" y="340" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallActivity_RegisterRandomTeam_di" bpmnElement="CallActivity_RegisterRandomTeam"><dc:Bounds x="870" y="230" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendAllocationSummary_di" bpmnElement="Task_SendAllocationSummary"><dc:Bounds x="680" y="100" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_AllStudentsPlaced_di" bpmnElement="EndEvent_AllStudentsPlaced"><dc:Bounds x="862" y="122" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="845" y="160" width="70" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ManualMerge_di" bpmnElement="Gateway_ManualMerge" isMarkerVisible="true"><dc:Bounds x="735" y="395" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestManualPlacement_di" bpmnElement="Task_RequestManualPlacement"><dc:Bounds x="840" y="380" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ManualPlacement_di" bpmnElement="EndEvent_ManualPlacement"><dc:Bounds x="1022" y="402" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1000" y="440" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_RegistrationDB_di" bpmnElement="DataStore_RegistrationDB"><dc:Bounds x="345" y="370" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="331" y="427" width="78" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_CallActivity_di" bpmnElement="TextAnnotation_CallActivity"><dc:Bounds x="1080" y="150" width="300" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_CallActivity_di" bpmnElement="Association_CallActivity"><di:waypoint x="1030" y="250" /><di:waypoint x="1080" y="205" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataInputAssociation_FetchUnallocated_di" bpmnElement="DataInputAssociation_FetchUnallocated"><di:waypoint x="370" y="370" /><di:waypoint x="370" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Closed_di" bpmnElement="Flow_Closed"><di:waypoint x="268" y="270" /><di:waypoint x="310" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fetched_di" bpmnElement="Flow_Fetched"><di:waypoint x="430" y="270" /><di:waypoint x="475" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_StudentsLeft_di" bpmnElement="Flow_StudentsLeft"><di:waypoint x="525" y="270" /><di:waypoint x="585" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="540" y="252" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoneLeft_di" bpmnElement="Flow_NoneLeft"><di:waypoint x="500" y="245" /><di:waypoint x="500" y="140" /><di:waypoint x="680" y="140" /><bpmndi:BPMNLabel><dc:Bounds x="508" y="190" width="14" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RoundsLeft_di" bpmnElement="Flow_RoundsLeft"><di:waypoint x="635" y="270" /><di:waypoint x="680" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="646" y="252" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RoundsExhausted_di" bpmnElement="Flow_RoundsExhausted"><di:waypoint x="610" y="295" /><di:waypoint x="610" y="420" /><di:waypoint x="735" y="420" /><bpmndi:BPMNLabel><dc:Bounds x="618" y="340" width="14" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InsufficientStudents_di" bpmnElement="Flow_InsufficientStudents"><di:waypoint x="760" y="328" /><di:waypoint x="760" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToManualPlacement_di" bpmnElement="Flow_ToManualPlacement"><di:waypoint x="785" y="420" /><di:waypoint x="840" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManualPlacementRequested_di" bpmnElement="Flow_ManualPlacementRequested"><di:waypoint x="960" y="420" /><di:waypoint x="1022" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Allocated_di" bpmnElement="Flow_Allocated"><di:waypoint x="800" y="270" /><di:waypoint x="870" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RecheckPool_di" bpmnElement="Flow_RecheckPool"><di:waypoint x="950" y="230" /><di:waypoint x="950" y="75" /><di:waypoint x="370" y="75" /><di:waypoint x="370" y="230" /><bpmndi:BPMNLabel><dc:Bounds x="585" y="28" width="150" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SummarySent_di" bpmnElement="Flow_SummarySent"><di:waypoint x="800" y="140" /><di:waypoint x="862" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
